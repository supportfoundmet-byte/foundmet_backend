PORT=4000
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/foundmet
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
SUPERADMIN_TOKEN_SECRET=replace-with-a-different-long-random-secret
SUPERADMIN_EMAIL=your-admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-12-character-secret
SUPERADMIN_NAME=FoundMet Superadmin
SUPERADMIN_DB_NAME=foundmet_superadmin
# Comma-separated list of browser origins allowed to call the API.
FRONTEND_URL=http://localhost:5173,https://foundmet.supportfoundmet.workers.dev
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
NODE_ENV=development
# SMTP settings used for the post-registration welcome email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FoundMet <no-reply@example.com>
APP_URL=http://localhost:5173
# Web Push (VAPID) keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
